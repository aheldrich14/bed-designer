# Planner agent (agent draft + design review). Without a key the app falls back to
# the built-in heuristic planner, so everything still works offline.
ANTHROPIC_API_KEY=
PLANNER_MODEL=claude-opus-5-5

# Renders (Gemini image editing). Without a key, the render tab shows the prompt only.
GEMINI_API_KEY=
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image

# Where the SQLite db and uploaded files live (default ./var)
DATA_DIR=./var

# Password gate for every page and API route (any username). Required on Vercel.
APP_PASSWORD=
