# Planner agent (agent draft + design review). Without a key the app falls back to
# the built-in heuristic planner, so everything still works offline.
ANTHROPIC_API_KEY=
PLANNER_MODEL=claude-opus-5-5

# Renders (Gemini image editing). Without a key, the render tab shows the prompt only.
GEMINI_API_KEY=
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image

# Database + file storage backend: "sqlite" (local file, default) or "supabase".
# Left unset, it uses Supabase whenever SUPABASE_URL and a secret key are set.
DB_BACKEND=

# SQLite: where the db and uploaded files live (default ./var)
DATA_DIR=./var

# Supabase (needed on Vercel, whose disk is temporary). Works in an existing
# project: run supabase/migrations/*.sql in the SQL editor once. Tables are
# prefixed bed_planner_ and files go in a private "bed-planner" bucket.
# Server-only secret key (sb_secret_... or the legacy service_role key). Never expose it to the browser.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# SUPABASE_TABLE_PREFIX=bed_planner_
# SUPABASE_BUCKET=bed-planner

# Password gate for every page and API route (any username). Required on Vercel.
APP_PASSWORD=
